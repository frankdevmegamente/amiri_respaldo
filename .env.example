# ==================================
# CONFIGURACIÓN DE BASE DE DATOS
# ==================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=guiaspar_amiri_db
DB_USER=root
DB_PASS=

# ==================================
# CONFIGURACIÓN DE APLICACIÓN
# ==================================
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/amiriAppProd

# ==================================
# CONFIGURACIÓN DE SESIÓN
# ==================================
SESSION_LIFETIME=3600
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=strict

# ==================================
# CONFIGURACIÓN DE SEGURIDAD
# ==================================
# Intentos de login permitidos
RATE_LIMIT_MAX_ATTEMPTS=5
# Tiempo de bloqueo en segundos (900 = 15 minutos)
RATE_LIMIT_DECAY_SECONDS=900

# ==================================
# CONFIGURACIÓN DE LOGS
# ==================================
LOG_LEVEL=error
LOG_MAX_FILES=5
LOG_MAX_SIZE_MB=5
